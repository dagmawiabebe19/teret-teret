# =============================================================================
# Teret Stories environment variables
# Copy to .env.local and fill in values. Never commit .env.local.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (app/lib/supabase/client.ts, server.ts, admin.ts)
# Get from: Supabase Dashboard → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Anthropic - story generation (app/api/generate-story/route.ts, server-only)
# Get from: https://console.anthropic.com/
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Optional: use AI for illustration prompts (default: local/deterministic)
# AI_ILLUSTRATION_PROMPTS=true

# -----------------------------------------------------------------------------
# Azure Speech - Amharic premium narration (app/api/tts/route.ts, lib/azureSpeech.ts)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# AZURE_SPEECH_ENDPOINT=https://eastus.tts.speech.microsoft.com/cognitiveservices/v1
# AZURE_VOICE_AM=am-ET-MekdesNeural

# ElevenLabs - English/Spanish premium narration (app/api/tts/route.ts, lib/elevenlabs.ts)
# Get from: https://elevenlabs.io/ → Profile → API Key
# Optional voice IDs (defaults use multilingual Sarah voice)
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_VOICE_EN=
# ELEVENLABS_VOICE_ES=
# ELEVENLABS_VOICE_AM=

# -----------------------------------------------------------------------------
# Stripe - subscriptions (app/api/create-checkout-session, stripe/*, config)
# Get from: https://dashboard.stripe.com/apikeys and Products/Prices
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price ID for $4.99/month recurring subscription (Stripe Dashboard → Products → Prices)
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# App URL - used for Stripe success/cancel/portal redirects (app/api/stripe/*, create-checkout-session)
# Set to production URL in production (e.g. https://teret.vercel.app)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
